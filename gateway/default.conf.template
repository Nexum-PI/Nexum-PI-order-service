# Gateway do NEXUM: única porta exposta (8080). O front chama só este endereço.
#   /api/auth, /api/staff     -> auth-service
#   /api/orders, /api/me      -> pedidos-service
#   /api/notifications        -> notificacao-service

# CORS: libera o front local (Vite 5173/4173) e o endereço em FRONT_ORIGIN
map $http_origin $cors_origin {
    default "";
    "~^http://localhost:(5173|4173)$" $http_origin;
    "~^http://127\.0\.0\.1:(5173|4173)$" $http_origin;
    "${FRONT_ORIGIN}" $http_origin;
}

server {
    listen 80;
    client_max_body_size 2m;

    # DNS interno do Docker. Os destinos ficam em variáveis para o nginx voltar a
    # resolver o nome a cada 10s: quando um serviço reinicia (ex.: esperando o MySQL)
    # ele ganha outro IP, e com "upstream" fixo o gateway continuaria no IP antigo,
    # mandando as chamadas para o serviço errado (401/403 "acesso não permitido").
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $auth        http://auth-service:8080;
    set $pedidos     http://pedidos-service:8080;
    set $notificacao http://notificacao-service:8080;

    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    add_header Vary Origin always;

    if ($request_method = OPTIONS) { return 204; }

    location /api/auth/          { proxy_pass $auth; }
    location /api/staff          { proxy_pass $auth; }
    location /api/orders         { proxy_pass $pedidos; }
    location /api/me/            { proxy_pass $pedidos; }
    location /api/notifications  { proxy_pass $notificacao; }

    location = /health { default_type application/json; return 200 '{"status":"UP"}'; }
    location = / {
        default_type application/json;
        return 200 '{"servico":"NEXUM API","rotas":["/api/auth/login","/api/orders","/api/orders/{codigo}/tracking","/api/me/orders","/api/staff","/api/notifications"]}';
    }
    location / { return 404; }
}
