# Gateway do NEXUM: única porta exposta (8080). O front chama só este endereço.
#   /api/auth, /api/staff     -> auth-service
#   /api/orders               -> pedidos-service
#   /api/notifications        -> notificacao-service

# CORS: libera o front local (Vite 5173/4173) e o endereço em FRONT_ORIGIN
map $http_origin $cors_origin {
    default "";
    "~^http://localhost:(5173|4173)$" $http_origin;
    "~^http://127\.0\.0\.1:(5173|4173)$" $http_origin;
    "${FRONT_ORIGIN}" $http_origin;
}

upstream auth        { server auth-service:8080; }
upstream pedidos     { server pedidos-service:8080; }
upstream notificacao { server notificacao-service:8080; }

server {
    listen 80;
    client_max_body_size 2m;

    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    add_header Vary Origin always;

    if ($request_method = OPTIONS) { return 204; }

    location /api/auth/          { proxy_pass http://auth; }
    location /api/staff          { proxy_pass http://auth; }
    location /api/orders         { proxy_pass http://pedidos; }
    location /api/notifications  { proxy_pass http://notificacao; }

    location = /health { default_type application/json; return 200 '{"status":"UP"}'; }
    location = / {
        default_type application/json;
        return 200 '{"servico":"NEXUM API","rotas":["/api/auth/login","/api/orders","/api/orders/{codigo}/tracking","/api/staff","/api/notifications"]}';
    }
    location / { return 404; }
}
