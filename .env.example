# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# ── Banco de dados online (MySQL, ex.: Aiven) ──────────────────────────────
# Cada serviço cria o próprio banco: nexum_auth, nexum_pedidos, nexum_notificacoes
DB_HOST=seu-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL_MODE=REQUIRED
DB_PREFIX=nexum

# ── Segurança ──────────────────────────────────────────────────────────────
# Segredo do token (mínimo 32 caracteres, igual para todos os serviços)
JWT_SECRET=
# Primeiro administrador (criado só quando não há nenhum funcionário)
ADMIN_EMAIL=admin@acasadotenis.com.br
ADMIN_PASSWORD=

# ── E-mail de confirmação do cadastro (SMTP) ───────────────────────────────
# Sem MAIL_HOST o e-mail não sai: o link aparece em `docker compose logs auth-service`.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=seu@gmail.com e, em MAIL_PASSWORD,
# uma "senha de app" (Conta Google > Segurança > Verificação em 2 etapas > Senhas de app).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Endereço do front, usado no link do e-mail
FRONT_URL=http://localhost:5173

# ── Outros ─────────────────────────────────────────────────────────────────
# Endereço do front (além de localhost:5173), para o CORS
FRONT_ORIGIN=http://localhost:5173
# Cria pedidos de exemplo quando o banco de pedidos está vazio
SAMPLE_DATA=true
